# Скопируй в .env рядом с docker-compose.prod.yml и заполни. Сам .env в git не попадает.

POSTGRES_USER=portfolio
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio

# Каждый секрет генерируется отдельно: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Логин в /admin, его создаёт сид
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Профили для блока «Активность»
GITHUB_USERNAME=sutuzhko
CODEWARS_USERNAME=sutuzhko
