# Фронт и API отдаются с одного origin, поэтому HttpOnly-cookie сессии работают без CORS.
# Сертификаты Caddy выпускает сам через Let's Encrypt, нужны только домен и открытые 80/443.

sutuzhko.space, www.sutuzhko.space {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3000
	}
	handle /uploads/* {
		reverse_proxy api:3000
	}

	# Неизвестные пути отдаём как index.html, дальше разбирается React Router.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# У ассетов хеш в имени, их можно кэшировать навсегда. index.html не кэшируем.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path /index.html
	header @html Cache-Control "no-cache"
}

# Временный тестовый стенд baby-tracker на этом же сервере (контейнер baby-web из стека
# /home/deploy/baby-tracker). После закрытия беты блок удаляем, как почистить сервер,
# описано в docs/DEPLOY_TEST.md репозитория baby-tracker.
baby-test.sutuzhko.space {
	reverse_proxy baby-web:80
}
