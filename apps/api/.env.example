DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio?schema=public"
PORT=3000

# Чью статистику отдаёт /api/stats
GITHUB_USERNAME=sutuzhko
CODEWARS_USERNAME=sutuzhko

# В проде нужны длинные случайные значения: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Админ, которого создаёт сид
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Куда складываются загрузки. В проде это путь к docker-тому.
UPLOAD_DIR=./uploads
