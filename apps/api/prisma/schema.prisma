// Поля `Json` с пометкой `// LocalizedText` хранят двуязычное значение
// `{ ru: string; en?: string }` (для списков `{ ru: string[]; en?: string[] }`).
// API отдаёт нужную локаль, а если её нет, то `ru`. Подробнее в BACKEND.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum AvailabilityStatus {
  ACTIVE
  OPEN
  NOTLOOKING
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum EducationType {
  MAIN
  ADDITIONAL
}

enum MediaType {
  AVATAR
  GALLERY
  CV
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  passwordHash  String
  role          UserRole       @default(ADMIN)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Profile {
  id              Int                @id @default(1) // синглтон
  name            Json // LocalizedText
  roleTitle       Json // LocalizedText
  headline        Json // LocalizedText, короткий питч в шапке главной
  location        Json // LocalizedText
  email           String
  avatarPhotoUrl  String?
  avatarColor     String?
  cvUrl           Json? // LocalizedText, у каждой локали своё PDF-резюме
  heroStack       String[] // слова, которые по очереди печатаются в шапке главной
  // Показатели над блоком «Обо мне»: [{ value: string, label: LocalizedText }]
  highlights      Json               @default("[]")
  availability    AvailabilityStatus @default(OPEN)
  bioMarkdown     Json // LocalizedText
  isBioHidden     Boolean            @default(false)
  bioUpdatedAt    DateTime?
  // Вводный абзац под заголовком страницы (LocalizedText)
  projectsIntro   Json?
  experienceIntro Json?
  contactIntro    Json?
  contactLinks    ContactLink[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model ContactLink {
  id        String  @id @default(cuid())
  icon      String // telegram, codewars, linkedin, github, email и т.п.
  url       String
  hidden    Boolean @default(false)
  order     Int     @default(0)
  profileId Int     @default(1)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Technology {
  id          String       @id @default(cuid())
  name        String
  category    String?
  // Float позволяет при drag&drop поставить запись между соседями с дробной позицией
  // и не перенумеровывать остальные.
  order       Float        @default(0)
  primaryFor  Project[]    @relation("ProjectPrimaryLanguage")
  projects    Project[]    @relation("ProjectTechnologies")
  experiences Experience[] @relation("ExperienceTech")
}

model Contributor {
  id       String    @id @default(cuid())
  name     Json // LocalizedText
  image    String?
  color    String?
  link     String?
  order    Float     @default(0) // Float по той же причине, что у Technology.order
  projects Project[] @relation("ProjectContributors")
}

model Project {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             Json // LocalizedText
  description       Json // LocalizedText (short)
  subtitle          Json? // LocalizedText, подзаголовок плитки и страницы проекта
  bodyMarkdown      Json // LocalizedText (full)
  bullets           Json? // LocalizedText list { ru: string[]; en?: string[] }
  role              Json? // LocalizedText
  category          String?
  period            String?
  tileColor         String?
  links             Json? // [{ label: LocalizedText | string, href: string }]
  runnable          Boolean       @default(false)
  runCommand        String?
  embedUrl          String? // URL запускаемого проекта для встраивания в iframe-раннер
  runHint           Json? // LocalizedText
  status            PublishStatus @default(DRAFT)
  hidden            Boolean       @default(false)
  pinned            Boolean       @default(false)
  order             Int           @default(0)
  primaryLanguageId String?
  primaryLanguage   Technology?   @relation("ProjectPrimaryLanguage", fields: [primaryLanguageId], references: [id])
  technologies      Technology[]  @relation("ProjectTechnologies")
  contributors      Contributor[] @relation("ProjectContributors")
  gallery           MediaAsset[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([primaryLanguageId])
}

model MediaAsset {
  id        String    @id @default(cuid())
  url       String
  type      MediaType
  alt       Json? // LocalizedText
  width     Int?
  height    Int?
  mime      String?
  size      Int?
  formats   Json? // responsive variants { thumbnail, small, medium, large }
  order     Int       @default(0)
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Experience {
  id        String       @id @default(cuid())
  role      Json // LocalizedText
  company   String
  location  Json? // LocalizedText
  sub       Json? // LocalizedText
  bullets   Json // LocalizedText list
  startDate DateTime
  endDate   DateTime?
  current   Boolean      @default(false)
  dotColor  String?
  tech      Technology[] @relation("ExperienceTech")
}

// Опыт и образование показываются таймлайном, поэтому сортируем по startDate, а не по order.
model Education {
  id        String        @id @default(cuid())
  type      EducationType @default(MAIN)
  degree    Json // LocalizedText
  place     Json? // LocalizedText
  startDate DateTime
  endDate   DateTime? // null, если курс укладывается в одну дату
}

model Language {
  id    String @id @default(cuid())
  name  Json // LocalizedText
  level String
  pct   Int
  order Int    @default(0)
}

model Skill {
  id    String @id @default(cuid())
  name  Json // LocalizedText
  order Float  @default(0) // Float по той же причине, что у Technology.order
}

// База знаний, видна только в приватной зоне
model Folder {
  id       String    @id @default(cuid())
  name     Json // LocalizedText
  order    Int       @default(0)
  parentId String?
  parent   Folder?   @relation("FolderTree", fields: [parentId], references: [id])
  children Folder[]  @relation("FolderTree")
  articles Article[]

  @@index([parentId])
}

model Article {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        Json // LocalizedText
  bodyMarkdown Json // LocalizedText
  tags         String[]
  status       PublishStatus @default(DRAFT)
  order        Int           @default(0)
  folderId     String?
  folder       Folder?       @relation(fields: [folderId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([folderId])
}

model Settings {
  id                Int      @id @default(1) // синглтон
  siteTitle         String   @default("bogdan.sutuzhko")
  interviewPassword String   @default("interview2026")
  defaultTheme      String   @default("dark")
  accentColor       String   @default("green") // green, blue или bright
  defaultLang       String   @default("ru") // язык для нового гостя и запасной язык
  // Языки, включённые на сайте. Выключенный язык пропадает из переключателя, но его
  // переводы остаются в базе.
  availableLanguages String[] @default(["ru", "en"])
  consoleGlow       Boolean  @default(true) // свечение за курсором в консоли
  // Какие секции главной показывать. Шапку с именем не выключаем, без неё главная теряет смысл.
  showHighlights    Boolean  @default(true) // показатели
  showAbout         Boolean  @default(true) // «Обо мне»
  showStack         Boolean  @default(true) // стек
  showActivity      Boolean  @default(true) // активность на GitHub и Codewars
  showNow           Boolean  @default(true) // баннер open-to-work
  showFeatured      Boolean  @default(true) // избранные проекты
  // Выключенная страница отдаёт 404 и пропадает из навигации, в том числе из cd/ls в консоли.
  showProjects      Boolean  @default(true) // страница /projects
  showExperience    Boolean  @default(true) // страница /experience
  showContact       Boolean  @default(true) // страница /contact
  updatedAt         DateTime @updatedAt
}
