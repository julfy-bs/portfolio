# Токен Chromatic для визуальных тестов Storybook (Manage, Configure, Project token).
# В CI лежит в GitHub Secrets.
CHROMATIC_PROJECT_TOKEN=

# С моками правки в админке остаются в памяти и не доходят до бэкенда. Скрипты
# сами задают флаг (`pnpm dev` без моков, `pnpm dev:mock` с ними), здесь только
# ручное переопределение.
# VITE_ENABLE_MOCKS=false

# Куда проксировать /api и /uploads, если NestJS поднят не на localhost:3000.
# VITE_API_PROXY_TARGET=http://localhost:3000
